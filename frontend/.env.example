# 复制为 .env 后按需修改：cp .env.example .env
# 仓库根目录的 .gitignore 已忽略 .env，本文件仅作模板提交

# 是否使用本地 mock 数据
# 只有 true 才用 src/mock/response.json 离线跑 UI；不写或写其他值都请求真实后端
VITE_USE_MOCK=false

# 后端接口地址。
# 本地开发可直连公网 IP；生产部署留空，走同源 /api（由 Nginx 反向代理）
VITE_API_BASE=http://8.163.105.39:8000

# 单次诊断请求超时（毫秒）
# 实测 GLM-4 单次 15–50s，后端含一次重试总超时 75s，这里需大于 75000
VITE_API_TIMEOUT=80000

# 上传类请求超时（毫秒），批量解析比单次诊断慢
VITE_API_UPLOAD_TIMEOUT=120000
