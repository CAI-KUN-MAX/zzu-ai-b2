# 复制为 .env 后按需修改：cp .env.example .env
# 仓库根目录的 .gitignore 已忽略 .env，本文件仅作模板提交

# 是否使用本地 mock 数据
# 只有 true 才用 src/mock/response.json 离线跑 UI；不写或写其他值都请求真实后端
VITE_USE_MOCK=false

# 留空时统一走同源 /api：本地由 Vite 代理，线上由 Nginx HTTPS 代理。
# 不要在生产构建中填写 :8000，避免绕过 TLS 与 Nginx 限流。
VITE_API_BASE=

# 单次诊断请求超时（毫秒）
# 实测 GLM-4 单次 15–50s，后端含一次重试总超时 75s，这里需大于 75000
VITE_API_TIMEOUT=80000
