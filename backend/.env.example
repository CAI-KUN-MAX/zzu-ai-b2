# Preserve existing diagnosis configuration in backend/.env.
LLM_API_KEY=
ZHIPUAI_API_KEY=
# Interviews reuse LLM_API_KEY. Existing diagnosis/matching model settings stay unchanged.
INTERVIEW_MODEL=glm-4-flash
# MOCK_MODE never generates fake interview feedback.
MOCK_MODE=false
ENABLE_DOCS=false
# Relative paths resolve against the repository root.
DATA_DIR=backend/data
MAX_UPLOAD_MB=15
OCR_MAX_PAGES=10
OCR_PROVIDER=auto
MATCH_LLM_TOP_K=8
JOB_EMBEDDING_ENABLED=false
MATCH_CONCURRENCY=3
